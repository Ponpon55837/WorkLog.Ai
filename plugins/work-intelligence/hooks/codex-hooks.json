{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|.*(work_finalize_session|work_write_idempotent))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/launch.mjs\" codex-finalize-reminder"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/launch.mjs\" codex-finalize-reminder"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/launch.mjs\" codex-finalize-reminder"
          }
        ]
      }
    ]
  }
}
