{
  "name": "work-intelligence",
  "displayName": "Work Intelligence",
  "version": "1.2.1",
  "description": "Local-first work records for coding agents: the Work Intelligence MCP server, its agent skill, and the finalize reminder, run from your local WorkLog.Ai checkout.",
  "author": { "name": "Ponpon55837", "url": "https://github.com/Ponpon55837" },
  "homepage": "https://github.com/Ponpon55837/WorkLog.Ai",
  "repository": "https://github.com/Ponpon55837/WorkLog.Ai",
  "license": "MIT",
  "icon": "./assets/icon.svg",
  "keywords": ["work-log", "mcp", "local-first", "reports"],
  "mcpServers": {
    "work-intelligence": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs", "mcp"]
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" finalize-reminder"
          }
        ]
      }
    ]
  }
}
