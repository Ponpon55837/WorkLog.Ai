{
  "name": "@work-intelligence/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@work-intelligence/core": "workspace:*",
    "@work-intelligence/schema": "workspace:*",
    "@work-intelligence/shared": "workspace:*",
    "@work-intelligence/storage": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "test:coverage": "vitest run src --config vitest.coverage.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
