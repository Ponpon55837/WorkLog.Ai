{
  "name": "work-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first developer work intelligence MVP",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @work-intelligence/server --filter @work-intelligence/web dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:server": "pnpm --filter @work-intelligence/server start",
    "start:mcp": "pnpm --filter @work-intelligence/mcp start",
    "test": "pnpm lint && pnpm format:check && pnpm --filter @work-intelligence/core test && pnpm --filter @work-intelligence/project-policy test && pnpm --filter @work-intelligence/schema test && pnpm --filter @work-intelligence/storage test && pnpm --filter @work-intelligence/server test && pnpm --filter @work-intelligence/mcp test",
    "test:coverage": "pnpm --filter @work-intelligence/schema test:coverage && pnpm --filter @work-intelligence/storage test:coverage",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  }
}
