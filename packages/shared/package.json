{
  "name": "@work-intelligence/shared",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database-path": {
      "types": "./dist/database-path.d.ts",
      "import": "./dist/database-path.js"
    },
    "./database-location": {
      "types": "./dist/database-location.d.ts",
      "import": "./dist/database-location.js"
    },
    "./app-version": {
      "types": "./dist/app-version.d.ts",
      "import": "./dist/app-version.js"
    },
    "./mcp-runtime": {
      "types": "./dist/mcp-runtime.d.ts",
      "import": "./dist/mcp-runtime.js"
    },
    "./file-identity": {
      "types": "./dist/file-identity.d.ts",
      "import": "./dist/file-identity.js"
    },
    "./sqlite-version": {
      "types": "./dist/sqlite-version.d.ts",
      "import": "./dist/sqlite-version.js"
    },
    "./instance-proof": {
      "types": "./dist/instance-proof.d.ts",
      "import": "./dist/instance-proof.js"
    },
    "./backup-name": {
      "types": "./dist/backup-name.d.ts",
      "import": "./dist/backup-name.js"
    },
    "./windows-system-tool": {
      "types": "./dist/windows-system-tool.d.ts",
      "import": "./dist/windows-system-tool.js"
    },
    "./loopback-port": {
      "types": "./dist/loopback-port.d.ts",
      "import": "./dist/loopback-port.js"
    },
    "./port-failure": {
      "types": "./dist/port-failure.d.ts",
      "import": "./dist/port-failure.js"
    },
    "./agent-observations": {
      "types": "./dist/agent-observations.d.ts",
      "import": "./dist/agent-observations.js"
    },
    "./mcp-contract-fingerprint": {
      "types": "./dist/mcp-contract-fingerprint.d.ts",
      "import": "./dist/mcp-contract-fingerprint.js"
    },
    "./agent-usage": {
      "types": "./dist/agent-usage/index.d.ts",
      "import": "./dist/agent-usage/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/runtime-package-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run --root ../.. tests/shared",
    "test:coverage": "vitest run --root ../.. --config packages/shared/vitest.coverage.config.ts"
  }
