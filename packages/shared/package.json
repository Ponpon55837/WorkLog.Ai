{
  "name": "@work-intelligence/shared",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app-version": {
      "types": "./dist/app-version.d.ts",
      "import": "./dist/app-version.js"
    },
    "./mcp-runtime": {
      "types": "./dist/mcp-runtime.d.ts",
      "import": "./dist/mcp-runtime.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/runtime-package-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run --root ../.. tests/shared",
    "test:coverage": "vitest run --root ../.. --config packages/shared/vitest.coverage.config.ts"
  }
}
