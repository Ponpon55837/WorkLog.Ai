{
  "name": "@work-intelligence/desktop-core",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@work-intelligence/schema": "workspace:*",
    "@work-intelligence/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. tests/desktop-core",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test:coverage": "vitest run --root ../.. --config packages/desktop-core/vitest.coverage.config.ts"
  }
}
