{
  "name": "@work-intelligence/desktop-core",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell/i18n": {
      "types": "./dist/shell/i18n.d.ts",
      "import": "./dist/shell/i18n.js"
    },
    "./shell/app-tabs": {
      "types": "./dist/shell/app-tabs.d.ts",
      "import": "./dist/shell/app-tabs.js"
    },
    "./shell/setup-i18n": {
      "types": "./dist/shell/setup-i18n.d.ts",
      "import": "./dist/shell/setup-i18n.js"
    },
    "./shell/port-i18n": {
      "types": "./dist/shell/port-i18n.d.ts",
      "import": "./dist/shell/port-i18n.js"
    },
    "./shell/agent-remove-i18n": {
      "types": "./dist/shell/agent-remove-i18n.d.ts",
      "import": "./dist/shell/agent-remove-i18n.js"
    },
    "./shell/agents-state": {
      "types": "./dist/shell/agents-state.d.ts",
      "import": "./dist/shell/agents-state.js"
    },
    "./shell/login-item-i18n": {
      "types": "./dist/shell/login-item-i18n.d.ts",
      "import": "./dist/shell/login-item-i18n.js"
    },
    "./shell/login-item-status": {
      "types": "./dist/shell/login-item-status.d.ts",
      "import": "./dist/shell/login-item-status.js"
    },
    "./shell/update-i18n": {
      "types": "./dist/shell/update-i18n.d.ts",
      "import": "./dist/shell/update-i18n.js"
    },
    "./shell/diagnostics-i18n": {
      "types": "./dist/shell/diagnostics-i18n.d.ts",
      "import": "./dist/shell/diagnostics-i18n.js"
    },
    "./shell/backup-directory-i18n": {
      "types": "./dist/shell/backup-directory-i18n.d.ts",
      "import": "./dist/shell/backup-directory-i18n.js"
    },
    "./shell/maintenance-i18n": {
      "types": "./dist/shell/maintenance-i18n.d.ts",
      "import": "./dist/shell/maintenance-i18n.js"
    },
    "./shell/startup-fallback-i18n": {
      "types": "./dist/shell/startup-fallback-i18n.d.ts",
      "import": "./dist/shell/startup-fallback-i18n.js"
    },
    "./shell/restore-i18n": {
      "types": "./dist/shell/restore-i18n.d.ts",
      "import": "./dist/shell/restore-i18n.js"
    },
    "./update-check/result": {
      "types": "./dist/update-check/result.d.ts",
      "import": "./dist/update-check/result.js"
    }
  },
  "dependencies": {
    "@work-intelligence/schema": "workspace:*",
    "@work-intelligence/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --config packages/desktop-core/vitest.config.ts tests/desktop-core",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test:coverage": "vitest run --root ../.. --config packages/desktop-core/vitest.coverage.config.ts"
  }
}
