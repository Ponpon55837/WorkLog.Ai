{
  "name": "@work-intelligence/schema",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./architecture-diagram": {
      "types": "./dist/architecture-diagram.d.ts",
      "import": "./dist/architecture-diagram.js"
    }
  },
  "dependencies": {
    "@work-intelligence/core": "workspace:*",
    "zod": "^3.25.76"
  },
  "scripts": {
    "build": "node ../../scripts/runtime-package-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run --root ../.. tests/schema",
    "test:coverage": "vitest run --root ../.. --config packages/schema/vitest.coverage.config.ts"
  }
}
