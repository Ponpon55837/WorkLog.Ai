{
  "name": "@work-intelligence/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@work-intelligence/core": "workspace:*",
    "@work-intelligence/project-policy": "workspace:*",
    "@work-intelligence/shared": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "test:coverage": "vitest run src --config vitest.coverage.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
